# Environment configuration for AzerothCore Manager Docker Compose
# Copy this file to .env and adjust the values for your system

# Absolute path on the HOST system that corresponds to /app/data in the container.
# Required so the manager can generate correct volume mounts for AzerothCore stacks.
#
# Linux example:   HOST_DATA_PATH=/home/username/AzerothCoreManager/data
# macOS example:   HOST_DATA_PATH=/Users/username/AzerothCoreManager/data
#
# Quick way to set it (run from project root):
#   echo "HOST_DATA_PATH=$(pwd)/data" > .env
HOST_DATA_PATH=/path/to/your/project/data
